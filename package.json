{
	"name": "normalize-url",
	"version": "9.0.1",
	"description": "Normalize a URL",
	"license": "MIT",
	"repository": "sindresorhus/normalize-url",
	"funding": "https://github.com/sponsors/sindresorhus",
	"author": "Sindre Sorhus <sindresorhus@gmail.com> (https://sindresorhus.com)",
	"type": "module",
	"exports": {
		"types": "./index.d.ts",
		"default": "./index.js"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"test": "xo && node --test"
	},
	"files": [
		"index.js",
		"index.d.ts"
	],
	"keywords": [
		"normalize",
		"url",
		"uri",
		"address",
		"string",
		"normalization",
		"normalisation",
		"query",
		"querystring",
		"simplify",
		"strip",
		"trim",
		"canonical"
	],
	"devDependencies": {
		"xo": "^5.0.1"
	},
	"c8": {
		"reporter": [
			"text",
			"lcov"
		]
	},
	"xo": [
		{
			"rules": {
				"unicorn/prefer-https": "off",
				"node-test/no-conditional-assertion": "off"
			}
		},
		{
			"files": "test.js",
			"rules": {
				"unicorn/no-break-in-nested-loop": "off"
			}
		}
	]
}
